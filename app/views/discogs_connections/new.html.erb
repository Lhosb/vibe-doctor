<h1 class="text-2xl font-bold">Connect Discogs</h1>

<%= form_with url: discogs_connection_path, class: "contents" do |form| %>
  <div class="my-5">
    <%= form.label :discogs_username %>
    <%= form.text_field :discogs_username, class: "block border rounded-md px-3 py-2 mt-1 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :discogs_token, "Discogs personal access token" %>
    <%= form.text_field :discogs_token, class: "block border rounded-md px-3 py-2 mt-1 w-full" %>
  </div>

  <%= form.submit "Connect", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
<% end %>
